{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "/timesheet",
  "redirects": [
    {
      "source": "/timesheet/",
      "destination": "/timesheet",
      "basePath": false,
      "internal": true,
      "statusCode": 308,
      "regex": "^/timesheet/$"
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/timesheet/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "clipboard-read=(self), clipboard-write=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ],
      "regex": "^/timesheet(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/db/bulk/[collection]",
      "regex": "^/api/db/bulk/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcollection": "nxtPcollection"
      },
      "namedRegex": "^/api/db/bulk/(?<nxtPcollection>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/db/[collection]",
      "regex": "^/api/db/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcollection": "nxtPcollection"
      },
      "namedRegex": "^/api/db/(?<nxtPcollection>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/db/[collection]/[id]",
      "regex": "^/api/db/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcollection": "nxtPcollection",
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/db/(?<nxtPcollection>[^/]+?)/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/feedback/[id]",
      "regex": "^/api/feedback/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/feedback/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/files/[...key]",
      "regex": "^/api/files/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/api/files/(?<nxtPkey>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
