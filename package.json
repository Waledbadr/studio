{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:base": "next dev --turbopack -p 3000",
    "dev": "concurrently -k -n next,keep \"npm run dev:base\" \"npm run keep-alive\"",
    "dev:local": "wrangler pages dev --proxy 3000",
    "dev:cloudflare": "npm run build:cloudflare && wrangler pages dev out",
    "dev:full": "concurrently -k -n cloudflare,next \"wrangler pages dev out\" \"npm run dev:base\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "build:cloudflare": "CLOUDFLARE_BUILD=true next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "keep-alive": "node scripts/keep-alive.mjs",
    "lookup:uid": "node --env-file=.env.local scripts/lookup-uid.mjs",
    "setup:dev": "node scripts/setup-dev.js || bash scripts/setup-dev.sh",
    "setup:prod": "node scripts/deploy.js || bash scripts/deploy.sh",
    "wrangler:dev": "wrangler pages dev out",
    "wrangler:deploy": "wrangler pages deploy out --project-name=estatecare-cloudflare",
    "d1:create": "wrangler d1 create estatecare-db",
    "d1:execute": "wrangler d1 execute estatecare-db --file=schema.sql",
    "d1:execute:local": "wrangler d1 execute estatecare-db --local --file=schema.sql",
    "d1:seed": "wrangler d1 execute estatecare-db --file=scripts/sample-data.sql",
    "d1:seed:local": "wrangler d1 execute estatecare-db --local --file=scripts/sample-data.sql",
    "d1:migrate:cleanup": "wrangler d1 execute estatecare-db --file=scripts/migrations/2025-08-27_residences_cleanup.sql",
    "d1:migrate:cleanup:local": "wrangler d1 execute estatecare-db --local --file=scripts/migrations/2025-08-27_residences_cleanup.sql",
    "d1:console": "wrangler d1 execute estatecare-db --command",
    "d1:console:local": "wrangler d1 execute estatecare-db --local --command",
    "d1:reset": "rm -rf .wrangler/state/v3/d1/ && npm run d1:execute:local",
    "d1:shell": "wrangler d1 execute estatecare-db --local --command",
    "r2:create": "wrangler r2 bucket create estatecare-files",
    "kv:create": "wrangler kv:namespace create ESTATECARE_KV",
    "kv:create:preview": "wrangler kv:namespace create ESTATECARE_KV --preview",
    "cloudflare:setup": "npm run d1:create && npm run d1:execute && npm run r2:create && npm run kv:create",
    "cloudflare:setup:local": "npm run d1:execute:local",
    "migrate:firebase": "bash scripts/migrate-firebase.sh",
    "deploy": "npm run build:cloudflare && npm run wrangler:deploy",
    "deploy:full": "bash scripts/deploy.sh",
    "firebase:setup": "node scripts/setup-firebase.js",
    "firebase:check": "node scripts/check-firestore.js",
    "migrate:firestore-to-d1": "node scripts/complete-migration.js",
    "migrate:firestore-only": "node scripts/run-migration.js",
    "migrate:apply-to-d1": "node scripts/apply-migration.js"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.14.1",
    "@genkit-ai/next": "^1.14.1",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase-admin": "^13.4.0",
    "genkit": "^1.14.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "next": "15.3.3",
    "patch-package": "^8.0.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250826.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.0",
    "genkit-cli": "^1.14.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.33.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
