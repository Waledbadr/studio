# Copy this file to `.env.local` for local dev or use as a reference
# when setting environment variables in Firebase App Hosting and Render.
# Do NOT commit real secrets.

# Firebase Web App config (all from the same Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firestore local cache mode in the browser (memory|persistent)
NEXT_PUBLIC_FIRESTORE_CACHE=memory

# Optional: Firestore emulator (local dev)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost:8080

# Toggle D1 mode: when true the app uses Cloudflare D1 instead of Firestore
NEXT_PUBLIC_USE_D1=true

# Cloudflare / D1 configuration (set in CI / Cloudflare Dashboard or GitHub Secrets)
# - CLOUDFLARE_ACCOUNT_ID: your Cloudflare account id (e.g. abcd1234...)
# - CLOUDFLARE_D1_TOKEN: token with D1 read/write access (store securely)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=

# JWT keys used by the app when using built-in auth (do NOT commit private key)
# - JWT_SECRET: symmetric secret (optional) or
# - JWT_PRIVATE_KEY / JWT_PUBLIC_KEY: RS256 key pair for signing/verifying
# If you store RSA PEM in env, prefer storing it base64-encoded and decoding at runtime.
JWT_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Local storage path for file uploads (production): ensure this path is writable by the runtime
STORAGE_PATH=/var/estatecare/storage

# Required for uploads: Vercel Blob Read/Write token
# Obtain from Vercel > Storage > Blob > Tokens
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_RKZUTiOcNz7fdUQU_hqzJrfLwCIAJ4S96m2BM43MFUMPlLn

# Optional: git metadata (Render provides these automatically)
NEXT_PUBLIC_GIT_BRANCH=
NEXT_PUBLIC_LAST_COMMIT_HASH=
NEXT_PUBLIC_LAST_COMMIT_DATE=

# Genkit / Google Generative AI (Gemini)
# At least one of these should be set for translation to work
GEMINI_API_KEY=AIzaSyBLt7IjHKlA4orEjyLcXg4vyjU9PQPorcQ
# Or alternatively:
# GOOGLE_API_KEY=
# GOOGLEAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override default model
# GENKIT_MODEL=googleai/gemini-2.0-flash

# Notes:
# - NEXT_PUBLIC_* vars are compiled into the client bundle at build time.
# - On Firebase App Hosting and Render, define these in the dashboard BEFORE build.
# - In Firebase Auth > Settings > Authorized domains, add:
#   - localhost (for dev)
#   - Your Firebase App Hosting domain(s)
#   - Your Render domain(s)
