# Cloudflare deployment environment variables
# Copy this file to .env.cloudflare or use it as a reference when deploying to Cloudflare.

# Local JWT auth secret for Cloudflare branch
AUTH_JWT_SECRET=

# Cloudflare account info
CLOUDFLARE_ACCOUNT_ID=
CF_API_TOKEN=

# Optional local dev worker overrides
# D1 and R2 bindings are configured in wrangler.jsonc, but if needed for local dev:
D1=
R2_BUCKET=

# Generative AI / Gemini
GEMINI_API_KEY=

# Optional runtime env / debug
NEXT_PUBLIC_GIT_BRANCH=
NEXT_PUBLIC_LAST_COMMIT_HASH=
NEXT_PUBLIC_LAST_COMMIT_DATE=
